{
    "name": "jpipe-extension",
    "displayName": "jPipe Language (McSCert)",
    "description": "Language Support for the jPipe language",
    "version": "2.0.3",
    "type": "module",
    "publisher": "mcscert",
    "author": "McMaster Centre for Software Certification (McSCert)",
    "license": "MIT",
    "icon": "images/logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/jpipe-mcscert/jpipe-vscode"
    },
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configurationDefaults": {
            "[jpipe]": {
                "editor.wordBasedSuggestions": "off",
                "editor.defaultFormatter": "mcscert.jpipe-extension"
            }
        },
        "languages": [
            {
                "id": "jpipe",
                "aliases": [
                    "jpipe",
                    "jpipe"
                ],
                "extensions": [
                    ".jd"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "dark": "images/icon_dark.svg",
                    "light": "images/icon_light.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "jpipe",
                "scopeName": "source.jpipe",
                "path": "syntaxes/jpipe.tmLanguage.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "jpipe",
                    "title": "jPipe",
                    "icon": "images/activity.svg"
                }
            ],
            "panel": [
                {
                    "id": "jpipe-results",
                    "title": "jPipe Results",
                    "icon": "images/activity.svg"
                }
            ]
        },
        "views": {
            "jpipe-results": [
                {
                    "id": "jpipe.results",
                    "name": "Results",
                    "icon": "$(checklist)",
                    "when": "jpipe.hasResults",
                    "contextualTitle": "jPipe Results"
                }
            ],
            "jpipe": [
                {
                    "id": "jpipe.models",
                    "name": "Models",
                    "icon": "images/activity.svg",
                    "contextualTitle": "jPipe"
                },
                {
                    "id": "jpipe.elements",
                    "when": "!jpipe.noModels",
                    "name": "Outline",
                    "icon": "$(symbol-class)",
                    "contextualTitle": "jPipe"
                },
                {
                    "id": "jpipe.libraries",
                    "when": "!jpipe.noModels",
                    "name": "Libraries",
                    "icon": "$(library)",
                    "contextualTitle": "jPipe"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "jpipe.models",
                "contents": "Welcome to jPipe.\nA justification explains why a conclusion can be trusted: evidence supports strategies, and strategies support the conclusion. This workspace has no model yet.\n[New Justification](command:jpipe.models.newJustification)\nA template is a justification with parts left open, for other justifications to implement.\n[New Template](command:jpipe.models.newTemplate)\nNew to jPipe? The [tutorials](https://www.jpipe.org/tutorials/) walk through a first model step by step.",
                "when": "workbenchState != empty"
            },
            {
                "view": "jpipe.models",
                "contents": "Welcome to jPipe.\njPipe models live in the files of a project. Open a folder to write your first justification.\n[Open Folder](command:vscode.openFolder)\nNew to jPipe? The [tutorials](https://www.jpipe.org/tutorials/) walk through a first model step by step.",
                "when": "workbenchState == empty"
            },
            {
                "view": "jpipe.libraries",
                "contents": "No step library was found in this workspace. A step library is a Python file whose functions use the `@evidence` and `@strategy` decorators of jpipe-runner.\n[New Library](command:jpipe.libraries.new)\n[Learn how to write one](https://github.com/jpipe-mcscert/jpipe-runner/blob/main/docs/authoring.md)"
            }
        ],
        "colors": [
            {
                "id": "jpipe.templateIconForeground",
                "description": "Colour of the template icon in the jPipe Models view. Defaults to the colour the editor gives interfaces, which is how templates appear in the Outline and Go to Symbol.",
                "defaults": {
                    "dark": "symbolIcon.interfaceForeground",
                    "light": "symbolIcon.interfaceForeground",
                    "highContrast": "symbolIcon.interfaceForeground",
                    "highContrastLight": "symbolIcon.interfaceForeground"
                }
            },
            {
                "id": "jpipe.justificationIconForeground",
                "description": "Colour of the justification icon in the jPipe Models view. Defaults to the colour the editor gives classes, which is how justifications appear in the Outline and Go to Symbol.",
                "defaults": {
                    "dark": "symbolIcon.classForeground",
                    "light": "symbolIcon.classForeground",
                    "highContrast": "symbolIcon.classForeground",
                    "highContrastLight": "symbolIcon.classForeground"
                }
            },
            {
                "id": "jpipe.compositionIconForeground",
                "description": "Colour of a composition's icon in the jPipe Models view: a model built by an operator such as assemble or refine. Defaults to the colour the editor gives functions.",
                "defaults": {
                    "dark": "symbolIcon.functionForeground",
                    "light": "symbolIcon.functionForeground",
                    "highContrast": "symbolIcon.functionForeground",
                    "highContrastLight": "symbolIcon.functionForeground"
                }
            },
            {
                "id": "jpipe.conclusionIconForeground",
                "description": "Colour of a conclusion's icon in the jPipe Outline. The diagram draws conclusions in grey; this defaults to the theme's icon colour.",
                "defaults": {
                    "dark": "icon.foreground",
                    "light": "icon.foreground",
                    "highContrast": "icon.foreground",
                    "highContrastLight": "icon.foreground"
                }
            },
            {
                "id": "jpipe.subConclusionIconForeground",
                "description": "Colour of a sub-conclusion's icon in the jPipe Outline. Defaults to the blue the diagram outlines sub-conclusions with.",
                "defaults": {
                    "dark": "#0072B2",
                    "light": "#0072B2",
                    "highContrast": "#0072B2",
                    "highContrastLight": "#0072B2"
                }
            },
            {
                "id": "jpipe.strategyIconForeground",
                "description": "Colour of a strategy's icon in the jPipe Outline. Defaults to the amber the diagram fills strategies with.",
                "defaults": {
                    "dark": "#F0C27F",
                    "light": "#E69F00",
                    "highContrast": "#F0C27F",
                    "highContrastLight": "#E69F00"
                }
            },
            {
                "id": "jpipe.evidenceIconForeground",
                "description": "Colour of an evidence's icon in the jPipe Outline. Defaults to the sky blue the diagram fills evidence with.",
                "defaults": {
                    "dark": "#9ECAE1",
                    "light": "#56B4E9",
                    "highContrast": "#9ECAE1",
                    "highContrastLight": "#56B4E9"
                }
            },
            {
                "id": "jpipe.supportIconForeground",
                "description": "Colour of an @support's icon in the jPipe Outline. The diagram leaves @support uncoloured; this defaults to the theme's muted text colour.",
                "defaults": {
                    "dark": "descriptionForeground",
                    "light": "descriptionForeground",
                    "highContrast": "descriptionForeground",
                    "highContrastLight": "descriptionForeground"
                }
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "jpipe-load",
                "superType": "namespace",
                "description": "Import keyword (load)"
            },
            {
                "id": "jpipe-structure",
                "superType": "type",
                "description": "Structural keywords (justification, template, implements)"
            },
            {
                "id": "jpipe-relation",
                "superType": "keyword",
                "description": "Relation keyword (supports)"
            },
            {
                "id": "jpipe-abstract",
                "superType": "keyword",
                "description": "Abstract element keyword (@support)"
            },
            {
                "id": "jpipe-element",
                "superType": "keyword",
                "description": "Element keywords (conclusion, evidence, strategy, sub-conclusion)"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "jpipe",
                "scopes": {
                    "jpipe-load": [
                        "entity.name.namespace.jpipe"
                    ],
                    "jpipe-structure": [
                        "support.type.jpipe"
                    ],
                    "jpipe-relation": [
                        "variable.other.enummember.jpipe"
                    ],
                    "jpipe-abstract": [
                        "storage.modifier.jpipe"
                    ],
                    "jpipe-element": [
                        "entity.name.function.jpipe"
                    ]
                }
            }
        ],
        "commands": [
            {
                "command": "jpipe.vis.preview",
                "title": "Open Diagram Preview",
                "category": "jPipe",
                "icon": "$(open-preview)"
            },
            {
                "command": "jpipe.downloadSVG",
                "title": "Export as SVG",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadPNG",
                "title": "Export as PNG",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadJSON",
                "title": "Export as JSON",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadJPEG",
                "title": "Export as JPEG",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadDOT",
                "title": "Export as DOT",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadPython",
                "title": "Export as Python",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadJPIPE",
                "title": "Export as jPipe",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.checkInstallation",
                "title": "Check jPipe Installation",
                "category": "jPipe",
                "icon": "$(check)"
            },
            {
                "command": "jpipe.installFromRelease",
                "title": "Install Compiler from GitHub Release",
                "category": "jPipe",
                "icon": "$(cloud-download)"
            },
            {
                "command": "jpipe.selectJarFile",
                "title": "Select Compiler JAR File…",
                "category": "jPipe",
                "icon": "$(folder-opened)"
            },
            {
                "command": "jpipe.export",
                "title": "Export Diagram (default format)",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.addExcludedDirectory",
                "title": "Add Excluded Directory",
                "category": "jPipe",
                "icon": "$(folder-opened)"
            },
            {
                "command": "jpipe.removeExcludedPath",
                "title": "Remove Excluded Path",
                "category": "jPipe",
                "icon": "$(folder)"
            },
            {
                "command": "jpipe.excludeResource",
                "title": "Exclude from jPipe Validation",
                "category": "jPipe"
            },
            {
                "command": "jpipe.includeResource",
                "title": "Include in jPipe Validation",
                "category": "jPipe"
            },
            {
                "command": "jpipe.organizeLoads",
                "title": "Organize Loads",
                "category": "jPipe",
                "icon": "$(list-ordered)"
            },
            {
                "command": "jpipe.autoIndent",
                "title": "Auto-indent and Align",
                "category": "jPipe",
                "icon": "$(list-flat)"
            },
            {
                "command": "jpipe.convertModelKind",
                "title": "Convert Justification to Template (or back)",
                "category": "jPipe",
                "icon": "$(replace)"
            },
            {
                "command": "jpipe.sortElements",
                "title": "Sort Elements in Reading Order",
                "category": "jPipe",
                "icon": "$(sort-precedence)"
            },
            {
                "command": "jpipe.extractTemplate",
                "title": "Extract Template from Justification",
                "category": "jPipe",
                "icon": "$(symbol-interface)"
            },
            {
                "command": "jpipe.models.refresh",
                "title": "Refresh Models",
                "category": "jPipe",
                "icon": "$(refresh)"
            },
            {
                "command": "jpipe.models.newJustification",
                "title": "New Justification…",
                "category": "jPipe",
                "icon": "$(add)"
            },
            {
                "command": "jpipe.models.newTemplate",
                "title": "New Template…",
                "category": "jPipe",
                "icon": "$(add)"
            },
            {
                "command": "jpipe.models.newImplementation",
                "title": "New Justification Implementing This Template…",
                "category": "jPipe",
                "icon": "$(add)"
            },
            {
                "command": "jpipe.run",
                "title": "Run Model",
                "category": "jPipe",
                "icon": "$(play)"
            },
            {
                "command": "jpipe.check",
                "title": "Check Model",
                "category": "jPipe",
                "icon": "$(checklist)"
            },
            {
                "command": "jpipe.runLibrary",
                "title": "Run as jPipe",
                "category": "jPipe",
                "icon": "$(play)"
            },
            {
                "command": "jpipe.checkLibrary",
                "title": "Check as jPipe Library",
                "category": "jPipe",
                "icon": "$(checklist)"
            },
            {
                "command": "jpipe.results.showOutput",
                "title": "Show the Run's Output",
                "category": "jPipe",
                "icon": "$(terminal)"
            },
            {
                "command": "jpipe.libraries.checkAll",
                "title": "Check All Libraries",
                "category": "jPipe",
                "icon": "$(check-all)"
            },
            {
                "command": "jpipe.libraries.uncheckAll",
                "title": "Uncheck All Libraries",
                "category": "jPipe",
                "icon": "$(clear-all)"
            },
            {
                "command": "jpipe.libraries.refresh",
                "title": "Refresh Libraries",
                "category": "jPipe",
                "icon": "$(refresh)"
            },
            {
                "command": "jpipe.libraries.new",
                "title": "New Library…",
                "category": "jPipe",
                "icon": "$(add)"
            },
            {
                "command": "jpipe.runner.fixEnvironment",
                "title": "Set Up the Python Environment for Runs",
                "category": "jPipe",
                "icon": "$(tools)"
            },
            {
                "command": "jpipe.runner.checkEnvironment",
                "title": "Check the Python Environment for Runs",
                "category": "jPipe"
            },
            {
                "command": "jpipe.models.scaffoldLibrary",
                "title": "Scaffold Step Library…",
                "category": "jPipe",
                "icon": "$(file-code)"
            }
        ],
        "submenus": [
            {
                "id": "jpipe.exportAs",
                "label": "Export as…"
            },
            {
                "id": "jpipe.models.new",
                "label": "New Model",
                "icon": "$(add)"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "jpipe.vis.preview",
                    "when": "resourceExtname == '.jd'",
                    "group": "jpipe@1"
                },
                {
                    "submenu": "jpipe.exportAs",
                    "when": "resourceExtname == '.jd'",
                    "group": "jpipe@2"
                },
                {
                    "command": "jpipe.excludeResource",
                    "when": "(resourceExtname == '.jd' || explorerResourceIsFolder) && resourcePath not in jpipe.excludedResourcePaths",
                    "group": "jpipe@3"
                },
                {
                    "command": "jpipe.includeResource",
                    "when": "(resourceExtname == '.jd' || explorerResourceIsFolder) && resourcePath in jpipe.excludedResourcePaths",
                    "group": "jpipe@3"
                }
            ],
            "commandPalette": [
                {
                    "command": "jpipe.excludeResource",
                    "when": "false"
                },
                {
                    "command": "jpipe.includeResource",
                    "when": "false"
                },
                {
                    "command": "jpipe.models.refresh",
                    "when": "jpipe.activated"
                },
                {
                    "command": "jpipe.models.newImplementation",
                    "when": "false"
                },
                {
                    "command": "jpipe.run",
                    "when": "jpipe.activated"
                },
                {
                    "command": "jpipe.check",
                    "when": "jpipe.activated"
                },
                {
                    "command": "jpipe.results.showOutput",
                    "when": "jpipe.hasResults"
                },
                {
                    "command": "jpipe.runLibrary",
                    "when": "resourceLangId == python && resourcePath in jpipe.checkedLibraryPaths"
                },
                {
                    "command": "jpipe.checkLibrary",
                    "when": "resourceLangId == python && resourcePath in jpipe.checkedLibraryPaths"
                },
                {
                    "command": "jpipe.libraries.checkAll",
                    "when": "jpipe.activated"
                },
                {
                    "command": "jpipe.libraries.uncheckAll",
                    "when": "jpipe.activated"
                },
                {
                    "command": "jpipe.libraries.refresh",
                    "when": "jpipe.activated"
                },
                {
                    "command": "jpipe.libraries.new",
                    "when": "jpipe.activated"
                },
                {
                    "command": "jpipe.models.scaffoldLibrary",
                    "when": "false"
                }
            ],
            "editor/title/run": [
                {
                    "command": "jpipe.runLibrary",
                    "when": "resourceLangId == python && resourcePath in jpipe.checkedLibraryPaths",
                    "group": "jpipe@0"
                },
                {
                    "command": "jpipe.checkLibrary",
                    "when": "resourceLangId == python && resourcePath in jpipe.checkedLibraryPaths",
                    "group": "jpipe@1"
                }
            ],
            "editor/title": [
                {
                    "command": "jpipe.run",
                    "when": "resourceLangId == jpipe",
                    "group": "navigation@0"
                },
                {
                    "command": "jpipe.vis.preview",
                    "when": "resourceLangId == jpipe",
                    "group": "navigation@1"
                }
            ],
            "editor/context": [
                {
                    "command": "jpipe.vis.preview",
                    "when": "resourceLangId == jpipe",
                    "group": "jpipe@1"
                },
                {
                    "submenu": "jpipe.exportAs",
                    "when": "resourceLangId == jpipe",
                    "group": "jpipe@2"
                },
                {
                    "command": "jpipe.excludeResource",
                    "when": "resourceLangId == jpipe && resourcePath not in jpipe.excludedResourcePaths",
                    "group": "jpipe@3"
                },
                {
                    "command": "jpipe.includeResource",
                    "when": "resourceLangId == jpipe && resourcePath in jpipe.excludedResourcePaths",
                    "group": "jpipe@3"
                }
            ],
            "jpipe.exportAs": [
                {
                    "command": "jpipe.downloadSVG",
                    "group": "1_format@1"
                },
                {
                    "command": "jpipe.downloadPNG",
                    "group": "1_format@2"
                },
                {
                    "command": "jpipe.downloadJSON",
                    "group": "1_format@3"
                },
                {
                    "command": "jpipe.downloadJPEG",
                    "group": "1_format@4"
                },
                {
                    "command": "jpipe.downloadDOT",
                    "group": "1_format@5"
                },
                {
                    "command": "jpipe.downloadPython",
                    "group": "1_format@6"
                },
                {
                    "command": "jpipe.downloadJPIPE",
                    "group": "1_format@7"
                }
            ],
            "view/title": [
                {
                    "submenu": "jpipe.models.new",
                    "when": "view == jpipe.models",
                    "group": "navigation@0"
                },
                {
                    "command": "jpipe.models.refresh",
                    "when": "view == jpipe.models",
                    "group": "navigation@1"
                },
                {
                    "command": "jpipe.libraries.checkAll",
                    "when": "view == jpipe.libraries",
                    "group": "navigation@1"
                },
                {
                    "command": "jpipe.libraries.uncheckAll",
                    "when": "view == jpipe.libraries",
                    "group": "navigation@2"
                },
                {
                    "command": "jpipe.libraries.refresh",
                    "when": "view == jpipe.libraries",
                    "group": "navigation@3"
                },
                {
                    "command": "jpipe.results.showOutput",
                    "when": "view == jpipe.results",
                    "group": "navigation@0"
                },
                {
                    "command": "jpipe.libraries.new",
                    "when": "view == jpipe.libraries",
                    "group": "navigation@0"
                },
                {
                    "command": "jpipe.runner.fixEnvironment",
                    "when": "view == jpipe.libraries",
                    "group": "navigation@4"
                }
            ],
            "view/item/context": [
                {
                    "command": "jpipe.models.newJustification",
                    "when": "view == jpipe.models && viewItem == jpipe.group.justifications",
                    "group": "inline"
                },
                {
                    "command": "jpipe.models.newTemplate",
                    "when": "view == jpipe.models && viewItem == jpipe.group.templates",
                    "group": "inline"
                },
                {
                    "command": "jpipe.run",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\.justification/",
                    "group": "inline@0"
                },
                {
                    "command": "jpipe.models.newImplementation",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\.template/",
                    "group": "inline@0"
                },
                {
                    "command": "jpipe.vis.preview",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\./",
                    "group": "inline@1"
                },
                {
                    "command": "jpipe.run",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\.justification/",
                    "group": "1_model@0"
                },
                {
                    "command": "jpipe.check",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\.justification/",
                    "group": "1_model@1"
                },
                {
                    "command": "jpipe.models.newImplementation",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\.template/",
                    "group": "1_model@1"
                },
                {
                    "command": "jpipe.models.scaffoldLibrary",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\.justification/",
                    "group": "1_model@2"
                },
                {
                    "command": "jpipe.vis.preview",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\./",
                    "group": "2_jpipe@1"
                },
                {
                    "submenu": "jpipe.exportAs",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\./",
                    "group": "2_jpipe@2"
                },
                {
                    "command": "jpipe.excludeResource",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\.[a-z]+$/",
                    "group": "2_jpipe@3"
                },
                {
                    "command": "jpipe.includeResource",
                    "when": "view == jpipe.models && viewItem =~ /^jpipe\\.model\\..*\\.excluded$/",
                    "group": "2_jpipe@3"
                }
            ],
            "jpipe.models.new": [
                {
                    "command": "jpipe.models.newJustification",
                    "group": "1_new@1"
                },
                {
                    "command": "jpipe.models.newTemplate",
                    "group": "1_new@2"
                }
            ]
        },
        "configuration": [
            {
                "title": "jPipe › Compiler › General",
                "order": 1,
                "properties": {
                    "jpipe.executionMode": {
                        "order": 1,
                        "type": "string",
                        "enum": [
                            "cli",
                            "jar",
                            "managed"
                        ],
                        "enumDescriptions": [
                            "Use the jpipe CLI executable (recommended). Configure the path below with 'CLI: Path'.",
                            "Use a JAR file (manual installation / developer mode). Configure the path below with 'JAR: File' and 'JAR: Java Executable'.",
                            "Use a compiler the extension downloads and manages from GitHub Releases. Install or switch versions via the 'Install Compiler from GitHub Release' command (requires Java)."
                        ],
                        "default": "cli",
                        "markdownDescription": "How to invoke the jPipe compiler. Choose **cli** (recommended), **jar** (manual installation), or **managed** (downloaded automatically from GitHub Releases — easiest on Windows).\n\n[Install from GitHub Release](command:jpipe.installFromRelease) · [Check jPipe installation](command:jpipe.checkInstallation)"
                    },
                    "jpipe.cliPath": {
                        "order": 2,
                        "type": "string",
                        "default": "jpipe",
                        "markdownDescription": "**[cli mode only]** Path to the `jpipe` CLI executable. Accepts a bare name (resolved via `PATH`), a relative path, or an absolute path."
                    },
                    "jpipe.jarFile": {
                        "order": 3,
                        "type": "string",
                        "default": "",
                        "markdownDescription": "**[jar mode only]** Absolute path to the `jpipe` JAR file.\n\n[Browse for a JAR file…](command:jpipe.selectJarFile)"
                    },
                    "jpipe.javaExecutable": {
                        "order": 4,
                        "type": "string",
                        "default": "java",
                        "markdownDescription": "**[jar / managed mode]** Path to the `java` executable used to run the JAR. Defaults to `java` (resolved via `PATH`)."
                    },
                    "jpipe.compilerTimeout": {
                        "order": 5,
                        "type": "number",
                        "default": 30,
                        "minimum": 1,
                        "markdownDescription": "Maximum time, in **seconds**, to wait for a compiler invocation before giving up. Increase for large models on slower machines."
                    },
                    "jpipe.jvmArgs": {
                        "order": 6,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "**[jar / managed mode]** Extra arguments passed to `java` before `-jar` (e.g. `[\"-Xmx2g\"]` to raise the heap for large models)."
                    },
                    "jpipe.extraPath": {
                        "order": 7,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Additional directories prepended to `PATH` when running the compiler, so external interpreters (e.g. `python3`, `dot`) can be found. Complements the built-in defaults."
                    }
                }
            },
            {
                "title": "jPipe › Compiler › Managed mode",
                "order": 2,
                "properties": {
                    "jpipe.managedCheckForUpdates": {
                        "order": 1,
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "When in **managed** mode, periodically check GitHub for a newer compiler release and offer to update."
                    },
                    "jpipe.managedUpdateCheckIntervalHours": {
                        "order": 2,
                        "type": "number",
                        "default": 24,
                        "minimum": 1,
                        "markdownDescription": "How often, in **hours**, to check for a newer managed compiler release (only when 'Managed: Check For Updates' is enabled)."
                    },
                    "jpipe.managedIncludePrereleases": {
                        "order": 3,
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Include pre-release (`-rc`) versions in the 'Install Compiler from GitHub Release' picker. The rolling `unstable` build is never listed."
                    },
                    "jpipe.managedRepository": {
                        "order": 4,
                        "type": "string",
                        "default": "jpipe-mcscert/jpipe-compiler",
                        "markdownDescription": "**[advanced]** GitHub `owner/repo` the managed compiler is downloaded from. Change only to use a fork or a testing repository."
                    }
                }
            },
            {
                "title": "jPipe › Compiler › Export",
                "order": 3,
                "properties": {
                    "jpipe.defaultExportFormat": {
                        "order": 1,
                        "type": "string",
                        "enum": [
                            "SVG",
                            "PNG",
                            "JPEG",
                            "JSON",
                            "DOT",
                            "PYTHON",
                            "JPIPE"
                        ],
                        "default": "SVG",
                        "markdownDescription": "Format used by the **jPipe: Export Diagram (default format)** command."
                    },
                    "jpipe.openAfterExport": {
                        "order": 2,
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Open the exported file automatically after a successful export/download."
                    }
                }
            },
            {
                "title": "jPipe › Compiler › Preview",
                "order": 4,
                "properties": {
                    "jpipe.previewZoomSensitivity": {
                        "order": 1,
                        "type": "number",
                        "default": 1,
                        "minimum": 0.25,
                        "maximum": 4,
                        "markdownDescription": "How far each scroll step zooms the diagram preview. Lower is slower and finer, higher is faster.\n\nOnly affects zooming with a mouse wheel or a trackpad pinch — dragging, the toolbar buttons and the keyboard shortcuts are unchanged."
                    }
                }
            },
            {
                "title": "jPipe › Compiler › Validation",
                "order": 5,
                "properties": {
                    "jpipe.additionalUnificationMethods": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "order": 8,
                        "markdownDescription": "Extra equivalence relations that `unifyBy` may name, beyond the `sameLabel` that ships with jPipe. Add the names your build registers, and the editor will stop warning about them."
                    },
                    "jpipe.excludedPaths": {
                        "order": 1,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Folders and individual `.jd` files (relative to workspace root) that are excluded from validation. Nothing excluded is checked — no errors and no warnings — which is what you want for deliberate counter-examples. Excluded items are dimmed and marked `⊘` in the Explorer, and changes take effect immediately.\n\nYou can also right-click a folder or a `.jd` file in the Explorer to exclude or re-include it.\n\n[Browse for directory…](command:jpipe.addExcludedDirectory)"
                    },
                    "jpipe.excludedDirectories": {
                        "order": 2,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Directories (relative to workspace root) whose `.jd` files are excluded from validation.",
                        "markdownDeprecationMessage": "Renamed to `#jpipe.excludedPaths#`, which also accepts individual files. Existing entries here are still honoured."
                    }
                }
            },
            {
                "title": "jPipe › Compiler › Logging",
                "order": 6,
                "properties": {
                    "jpipe.logLevel": {
                        "order": 1,
                        "type": "string",
                        "enum": [
                            "off",
                            "error",
                            "warn",
                            "info",
                            "debug",
                            "trace"
                        ],
                        "enumDescriptions": [
                            "No logging.",
                            "Errors only.",
                            "Errors and warnings.",
                            "Errors, warnings, and key lifecycle events (default).",
                            "Detailed operational info (commands, renders, imports).",
                            "Everything, including per-cursor and per-completion events."
                        ],
                        "default": "info",
                        "description": "Verbosity of the jPipe log channel (Output > jPipe). The language server log level (Output > jPipe Language Server) is set once at startup and requires a window reload to change."
                    }
                }
            },
            {
                "title": "jPipe › Runner › General",
                "order": 7,
                "properties": {
                    "jpipe.runner.selectInEditor": {
                        "order": 1,
                        "type": "boolean",
                        "default": true,
                        "scope": "resource",
                        "markdownDescription": "**[workspace mode only]** Use the same Python environment in the editor as for runs. This is what stops the editor from underlining `from jpipe_runner import …` in your step libraries. Requires the Python extension.\n\nTurn it off if you prefer to choose the editor’s Python interpreter yourself. Runs are not affected."
                    },
                    "jpipe.runner.offerSetup": {
                        "order": 2,
                        "type": "boolean",
                        "default": true,
                        "scope": "resource",
                        "markdownDescription": "**[workspace mode only]** Let jPipe suggest setting up the Python environment when it notices that your step libraries cannot run yet, and suggest installing Pylance when a workspace with step libraries does not have it.\n\nTurn it off to stop the suggestions. You can still set the environment up whenever you want, from the Libraries view or by pressing ▶, and install Pylance from Check jPipe Installation."
                    },
                    "jpipe.runner.libraries": {
                        "order": 3,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "scope": "resource",
                        "markdownDescription": "The step libraries used when you run a model. You normally do not edit this list by hand: tick and untick libraries in the **Libraries** view of the jPipe activity, and the list follows.\n\nEach entry is a Python file, given relative to the workspace folder. Wildcards are not supported."
                    }
                }
            },
            {
                "title": "jPipe › Runner › Execution",
                "order": 8,
                "properties": {
                    "jpipe.runner.environment": {
                        "order": 1,
                        "type": "string",
                        "enum": [
                            "workspace",
                            "command"
                        ],
                        "markdownEnumDescriptions": [
                            "Use this workspace’s own Python environment: a virtual environment in the folder, or the one your Pipenv, Poetry or uv project uses. If it is missing, or has no jpipe-runner, jPipe offers to fix that, and always asks before changing anything.",
                            "Use the program set in **Runner: Command**. jPipe leaves your Python environments alone."
                        ],
                        "default": "workspace",
                        "scope": "resource",
                        "markdownDescription": "Which Python environment runs your models when you press ▶.\n\n- **workspace** (recommended): the environment that belongs to this workspace. If there is none yet, jPipe offers to create one for you.\n- **command**: a jpipe-runner program you choose yourself.\n\n[Set up the Python environment](command:jpipe.runner.fixEnvironment) · [Check the Python environment](command:jpipe.runner.checkEnvironment)"
                    },
                    "jpipe.runner.command": {
                        "order": 2,
                        "type": "string",
                        "default": "",
                        "scope": "machine-overridable",
                        "markdownDescription": "**[command mode only]** The jpipe-runner program to use: a name such as `jpipe-runner`, or the full path to it. Leave empty to use the `jpipe-runner` installed on your computer."
                    },
                    "jpipe.runner.jobs": {
                        "order": 3,
                        "type": "string",
                        "default": "auto",
                        "pattern": "^(auto|[1-9][0-9]*)$",
                        "patternErrorMessage": "Write auto, or a whole number of at least 1.",
                        "scope": "resource",
                        "markdownDescription": "How many steps a run may run at the same time, with jpipe-runner 4.4 or newer. Steps that do not depend on each other then run together, which makes runs with slow steps faster. A step still waits for everything that supports it.\n\n- **auto** (default): one step per processor.\n- **a number**, such as `4`: at most that many. `1` runs one step at a time, as jpipe-runner does by default, in CI for example. A number larger than your computer's processors is lowered to that count.\n\nA step library must be ready for steps that run together: a step that writes a file another evidence reads, or that changes the working directory or an environment variable, can fail here and pass when its steps run one at a time. If a run fails in the editor but not elsewhere, set this to `1`. jpipe-runner's guide to writing step libraries lists what to avoid, under \"Steps that run together\". Older jpipe-runner releases always run one step at a time."
                    }
                }
            },
            {
                "title": "jPipe › Runner › Development",
                "order": 9,
                "properties": {
                    "jpipe.runner.localSource": {
                        "order": 1,
                        "type": "string",
                        "default": "",
                        "scope": "machine-overridable",
                        "markdownDescription": "**[workspace mode only]** For working on jpipe-runner itself: the folder of a local copy of jpipe-runner to run your models with, instead of a published release. Leave empty to use a published release, which is what you want unless you are changing the runner.\n\nWhen set, jPipe offers to install that copy in the workspace's Python environment, so that a change you make to the runner shows in the next run. Your project files are not changed.\n\n[Set up the Python environment](command:jpipe.runner.fixEnvironment) · [Check the Python environment](command:jpipe.runner.checkEnvironment)"
                    }
                }
            }
        ],
        "taskDefinitions": [
            {
                "type": "jpipe",
                "required": [
                    "model"
                ],
                "properties": {
                    "model": {
                        "type": "string",
                        "description": "The justification to run with jpipe-runner."
                    }
                }
            }
        ]
    },
    "activationEvents": [
        "workspaceContains:**/*.jd"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes coverage",
        "vscode:prepublish": "npm run build:release",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/jpipe.tmLanguage.json ./syntaxes/jpipe.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json src/webview && node esbuild.mjs",
        "build:release": "npm run build:prepare && tsc -b tsconfig.json src/webview && node esbuild.mjs --minify",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json src/webview --watch\" \"node esbuild.mjs --watch\"",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "jpipe-language": "2.0.3",
        "vscode-languageclient": "~10.1.2",
        "vscode-languageserver": "~10.1.2"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "ajv": "~8.20.0",
        "concurrently": "~10.0.7",
        "esbuild": "~0.28.2",
        "happy-dom": "~21.0.4"
    },
    "vsce": {
        "dependencies": false
    }
}
