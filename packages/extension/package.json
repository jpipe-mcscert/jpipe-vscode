{
    "name": "jpipe-extension",
    "displayName": "jPipe Language (McSCert)",
    "description": "Language Support for the jPipe language",
    "version": "1.8.0",
    "type": "module",
    "publisher": "mcscert",
    "author": "McMaster Centre for Software Certification (McSCert)",
    "license": "MIT",
    "icon": "images/logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/jpipe-mcscert/jpipe-vscode"
    },
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configurationDefaults": {
            "[jpipe]": {
                "editor.wordBasedSuggestions": "off",
                "editor.defaultFormatter": "mcscert.jpipe-extension"
            }
        },
        "languages": [
            {
                "id": "jpipe",
                "aliases": [
                    "jpipe",
                    "jpipe"
                ],
                "extensions": [
                    ".jd"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "dark": "images/icon_dark.svg",
                    "light": "images/icon_light.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "jpipe",
                "scopeName": "source.jpipe",
                "path": "syntaxes/jpipe.tmLanguage.json"
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "jpipe-load",
                "superType": "namespace",
                "description": "Import keyword (load)"
            },
            {
                "id": "jpipe-structure",
                "superType": "type",
                "description": "Structural keywords (justification, template, implements)"
            },
            {
                "id": "jpipe-relation",
                "superType": "keyword",
                "description": "Relation keyword (supports)"
            },
            {
                "id": "jpipe-abstract",
                "superType": "keyword",
                "description": "Abstract element keyword (@support)"
            },
            {
                "id": "jpipe-element",
                "superType": "keyword",
                "description": "Element keywords (conclusion, evidence, strategy, sub-conclusion)"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "jpipe",
                "scopes": {
                    "jpipe-load": [
                        "entity.name.namespace.jpipe"
                    ],
                    "jpipe-structure": [
                        "support.type.jpipe"
                    ],
                    "jpipe-relation": [
                        "variable.other.enummember.jpipe"
                    ],
                    "jpipe-abstract": [
                        "storage.modifier.jpipe"
                    ],
                    "jpipe-element": [
                        "entity.name.function.jpipe"
                    ]
                }
            }
        ],
        "commands": [
            {
                "command": "jpipe.vis.preview",
                "title": "Open Diagram Preview",
                "category": "jPipe",
                "icon": "$(open-preview)"
            },
            {
                "command": "jpipe.downloadSVG",
                "title": "Download as SVG",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadPNG",
                "title": "Download as PNG",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadJSON",
                "title": "Download as JSON",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadJPEG",
                "title": "Download as JPEG",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadDOT",
                "title": "Download as DOT",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadPython",
                "title": "Download as Python",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.downloadJPIPE",
                "title": "Download as jPipe",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.checkInstallation",
                "title": "Check jPipe Installation",
                "category": "jPipe",
                "icon": "$(check)"
            },
            {
                "command": "jpipe.installFromRelease",
                "title": "Install Compiler from GitHub Release",
                "category": "jPipe",
                "icon": "$(cloud-download)"
            },
            {
                "command": "jpipe.selectJarFile",
                "title": "Select Compiler JAR File…",
                "category": "jPipe",
                "icon": "$(folder-opened)"
            },
            {
                "command": "jpipe.export",
                "title": "Export Diagram (default format)",
                "category": "jPipe",
                "icon": "$(save)"
            },
            {
                "command": "jpipe.addExcludedDirectory",
                "title": "Add Excluded Directory",
                "category": "jPipe",
                "icon": "$(folder-opened)"
            },
            {
                "command": "jpipe.removeExcludedPath",
                "title": "Remove Excluded Path",
                "category": "jPipe",
                "icon": "$(folder)"
            },
            {
                "command": "jpipe.excludeResource",
                "title": "Exclude from jPipe Validation",
                "category": "jPipe"
            },
            {
                "command": "jpipe.includeResource",
                "title": "Include in jPipe Validation",
                "category": "jPipe"
            },
            {
                "command": "jpipe.organizeLoads",
                "title": "Organize Loads",
                "category": "jPipe",
                "icon": "$(list-ordered)"
            },
            {
                "command": "jpipe.autoIndent",
                "title": "Auto-indent and Align",
                "category": "jPipe",
                "icon": "$(list-flat)"
            },
            {
                "command": "jpipe.convertModelKind",
                "title": "Convert Justification to Template (or back)",
                "category": "jPipe",
                "icon": "$(replace)"
            },
            {
                "command": "jpipe.sortElements",
                "title": "Sort Elements in Reading Order",
                "category": "jPipe",
                "icon": "$(sort-precedence)"
            },
            {
                "command": "jpipe.extractTemplate",
                "title": "Extract Template from Justification",
                "category": "jPipe",
                "icon": "$(symbol-interface)"
            }
        ],
        "submenus": [
            {
                "id": "jpipe.submenu",
                "label": "jPipe"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "jpipe.excludeResource",
                    "when": "(explorerResourceIsFolder || resourceExtname == '.jd') && resourcePath not in jpipe.excludedResourcePaths",
                    "group": "jpipe@1"
                },
                {
                    "command": "jpipe.includeResource",
                    "when": "(explorerResourceIsFolder || resourceExtname == '.jd') && resourcePath in jpipe.excludedResourcePaths",
                    "group": "jpipe@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "jpipe.excludeResource",
                    "when": "false"
                },
                {
                    "command": "jpipe.includeResource",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "jpipe.vis.preview",
                    "when": "resourceLangId == jpipe",
                    "group": "navigation@0"
                }
            ],
            "editor/context": [
                {
                    "submenu": "jpipe.submenu",
                    "when": "resourceLangId == jpipe",
                    "group": "navigation"
                }
            ],
            "jpipe.submenu": [
                {
                    "command": "jpipe.vis.preview",
                    "group": "1_view@1"
                },
                {
                    "command": "jpipe.downloadSVG",
                    "group": "2_download@1"
                },
                {
                    "command": "jpipe.downloadPNG",
                    "group": "2_download@2"
                },
                {
                    "command": "jpipe.downloadJSON",
                    "group": "2_download@3"
                },
                {
                    "command": "jpipe.downloadJPEG",
                    "group": "2_download@4"
                },
                {
                    "command": "jpipe.downloadDOT",
                    "group": "2_download@5"
                },
                {
                    "command": "jpipe.downloadPython",
                    "group": "2_download@6"
                },
                {
                    "command": "jpipe.downloadJPIPE",
                    "group": "2_download@7"
                },
                {
                    "command": "jpipe.excludeResource",
                    "when": "resourcePath not in jpipe.excludedResourcePaths",
                    "group": "3_validation@1"
                },
                {
                    "command": "jpipe.includeResource",
                    "when": "resourcePath in jpipe.excludedResourcePaths",
                    "group": "3_validation@1"
                }
            ]
        },
        "configuration": [
            {
                "title": "jPipe: Compiler",
                "order": 1,
                "properties": {
                    "jpipe.executionMode": {
                        "order": 1,
                        "type": "string",
                        "enum": [
                            "cli",
                            "jar",
                            "managed"
                        ],
                        "enumDescriptions": [
                            "Use the jpipe CLI executable (recommended). Configure the path below with 'CLI: Path'.",
                            "Use a JAR file (manual installation / developer mode). Configure the path below with 'JAR: File' and 'JAR: Java Executable'.",
                            "Use a compiler the extension downloads and manages from GitHub Releases. Install or switch versions via the 'Install Compiler from GitHub Release' command (requires Java)."
                        ],
                        "default": "cli",
                        "markdownDescription": "How to invoke the jPipe compiler. Choose **cli** (recommended), **jar** (manual installation), or **managed** (downloaded automatically from GitHub Releases — easiest on Windows).\n\n[Install from GitHub Release](command:jpipe.installFromRelease) · [Check jPipe installation](command:jpipe.checkInstallation)"
                    },
                    "jpipe.cliPath": {
                        "order": 2,
                        "type": "string",
                        "default": "jpipe",
                        "markdownDescription": "**[cli mode only]** Path to the `jpipe` CLI executable. Accepts a bare name (resolved via `PATH`), a relative path, or an absolute path."
                    },
                    "jpipe.jarFile": {
                        "order": 3,
                        "type": "string",
                        "default": "",
                        "markdownDescription": "**[jar mode only]** Absolute path to the `jpipe` JAR file.\n\n[Browse for a JAR file…](command:jpipe.selectJarFile)"
                    },
                    "jpipe.javaExecutable": {
                        "order": 4,
                        "type": "string",
                        "default": "java",
                        "markdownDescription": "**[jar / managed mode]** Path to the `java` executable used to run the JAR. Defaults to `java` (resolved via `PATH`)."
                    },
                    "jpipe.compilerTimeout": {
                        "order": 5,
                        "type": "number",
                        "default": 30,
                        "minimum": 1,
                        "markdownDescription": "Maximum time, in **seconds**, to wait for a compiler invocation before giving up. Increase for large models on slower machines."
                    },
                    "jpipe.jvmArgs": {
                        "order": 6,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "**[jar / managed mode]** Extra arguments passed to `java` before `-jar` (e.g. `[\"-Xmx2g\"]` to raise the heap for large models)."
                    },
                    "jpipe.extraPath": {
                        "order": 7,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Additional directories prepended to `PATH` when running the compiler, so external interpreters (e.g. `python3`, `dot`) can be found. Complements the built-in defaults."
                    }
                }
            },
            {
                "title": "jPipe: Managed Compiler",
                "order": 2,
                "properties": {
                    "jpipe.managedCheckForUpdates": {
                        "order": 1,
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "When in **managed** mode, periodically check GitHub for a newer compiler release and offer to update."
                    },
                    "jpipe.managedUpdateCheckIntervalHours": {
                        "order": 2,
                        "type": "number",
                        "default": 24,
                        "minimum": 1,
                        "markdownDescription": "How often, in **hours**, to check for a newer managed compiler release (only when 'Managed: Check For Updates' is enabled)."
                    },
                    "jpipe.managedIncludePrereleases": {
                        "order": 3,
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Include pre-release (`-rc`) versions in the 'Install Compiler from GitHub Release' picker. The rolling `unstable` build is never listed."
                    },
                    "jpipe.managedRepository": {
                        "order": 4,
                        "type": "string",
                        "default": "jpipe-mcscert/jpipe-compiler",
                        "markdownDescription": "**[advanced]** GitHub `owner/repo` the managed compiler is downloaded from. Change only to use a fork or a testing repository."
                    }
                }
            },
            {
                "title": "jPipe: Export",
                "order": 3,
                "properties": {
                    "jpipe.defaultExportFormat": {
                        "order": 1,
                        "type": "string",
                        "enum": [
                            "SVG",
                            "PNG",
                            "JPEG",
                            "JSON",
                            "DOT",
                            "PYTHON",
                            "JPIPE"
                        ],
                        "default": "SVG",
                        "markdownDescription": "Format used by the **jPipe: Export Diagram (default format)** command."
                    },
                    "jpipe.openAfterExport": {
                        "order": 2,
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Open the exported file automatically after a successful export/download."
                    }
                }
            },
            {
                "title": "jPipe: Preview",
                "order": 4,
                "properties": {
                    "jpipe.previewZoomSensitivity": {
                        "order": 1,
                        "type": "number",
                        "default": 1,
                        "minimum": 0.25,
                        "maximum": 4,
                        "markdownDescription": "How far each scroll step zooms the diagram preview. Lower is slower and finer, higher is faster.\n\nOnly affects zooming with a mouse wheel or a trackpad pinch — dragging, the toolbar buttons and the keyboard shortcuts are unchanged."
                    }
                }
            },
            {
                "title": "jPipe: Validation",
                "order": 5,
                "properties": {
                    "jpipe.additionalUnificationMethods": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "order": 8,
                        "markdownDescription": "Extra equivalence relations that `unifyBy` may name, beyond the `sameLabel` that ships with jPipe. Add the names your build registers, and the editor will stop warning about them."
                    },
                    "jpipe.excludedPaths": {
                        "order": 1,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Folders and individual `.jd` files (relative to workspace root) that are excluded from validation. Nothing excluded is checked — no errors and no warnings — which is what you want for deliberate counter-examples. Excluded items are dimmed and marked `⊘` in the Explorer, and changes take effect immediately.\n\nYou can also right-click a folder or a `.jd` file in the Explorer to exclude or re-include it.\n\n[Browse for directory…](command:jpipe.addExcludedDirectory)"
                    },
                    "jpipe.excludedDirectories": {
                        "order": 2,
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Directories (relative to workspace root) whose `.jd` files are excluded from validation.",
                        "markdownDeprecationMessage": "Renamed to `#jpipe.excludedPaths#`, which also accepts individual files. Existing entries here are still honoured."
                    }
                }
            },
            {
                "title": "jPipe: Logging",
                "order": 6,
                "properties": {
                    "jpipe.logLevel": {
                        "order": 1,
                        "type": "string",
                        "enum": [
                            "off",
                            "error",
                            "warn",
                            "info",
                            "debug",
                            "trace"
                        ],
                        "enumDescriptions": [
                            "No logging.",
                            "Errors only.",
                            "Errors and warnings.",
                            "Errors, warnings, and key lifecycle events (default).",
                            "Detailed operational info (commands, renders, imports).",
                            "Everything, including per-cursor and per-completion events."
                        ],
                        "default": "info",
                        "description": "Verbosity of the jPipe log channel (Output > jPipe). The language server log level (Output > jPipe Language Server) is set once at startup and requires a window reload to change."
                    }
                }
            }
        ]
    },
    "activationEvents": [
        "workspaceContains:**/*.jd"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes coverage",
        "vscode:prepublish": "npm run build:release",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/jpipe.tmLanguage.json ./syntaxes/jpipe.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json src/webview && node esbuild.mjs",
        "build:release": "npm run build:prepare && tsc -b tsconfig.json src/webview && node esbuild.mjs --minify",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json src/webview --watch\" \"node esbuild.mjs --watch\"",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "jpipe-language": "1.8.0",
        "vscode-languageclient": "~10.0.1",
        "vscode-languageserver": "~10.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "@vitest/coverage-v8": "~4.1.10",
        "ajv": "~8.20.0",
        "concurrently": "~10.0.4",
        "esbuild": "~0.28.2",
        "happy-dom": "~20.11.2",
        "vitest": "~4.1.10"
    },
    "vsce": {
        "dependencies": false
    }
}
